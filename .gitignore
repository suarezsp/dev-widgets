# Distribution builds
dist/
.build-deb/
.build-rpm/
*.deb
*.dmg
*.app/
*.appex/
*.zip
*.tar.gz

# Scratch output of the render tools
widget-renders*/
renders/

# Python
__pycache__/
*.pyc

# macOS and editors
.DS_Store
.AppleDouble
.vscode/
.idea/
*.swp

# Secrets: signing certificates, keys, profiles and tokens never
# go in the repository (.github/ holds only CI and docs).
.env
.env.*
*.p12
*.p8
*.pem
*.cer
*.mobileprovision
*.provisionprofile
